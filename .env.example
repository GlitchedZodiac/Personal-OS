# Personal OS — environment contract
# Copy to .env.local and fill in. Production values live in Vercel
# (vercel env pull .env.local --environment=production), except
# DATABASE_URL / DIRECT_URL which are Sensitive (write-only) there —
# fetch those from the Supabase dashboard (Connect → URI).

# ── Database (Supabase Postgres via Prisma) ──────────────────────────
# Pooled connection (pgbouncer) for the app:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# Direct connection for migrations:
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# ── AI (all-OpenAI: GPT-5.6 tiers + gpt-transcribe voice) ────────────
OPENAI_API_KEY=""
# Model tiers (see lib/openai.ts): terra ($2/$12 per MTok) runs everyday
# chat/photo parsing; sol ($5/$30) runs deep synthesis (plan generation,
# trend insights/projections). luna ($0.20/$1.20) available via override.
# OPENAI_MODEL=""        # everyday tier override (default gpt-5.6-terra)
# OPENAI_COACH_MODEL=""  # synthesis tier override (default gpt-5.6-sol)

# ── Auth (single-user PIN gate) ──────────────────────────────────────
# APP_PIN is the BOOTSTRAP seed: on first boot it becomes the stored PIN in
# auth_credentials, which the web login and device pairing then share. Change
# the PIN in Settings afterwards — not here (lib/pin-auth.ts).
APP_PIN="1234"
# REQUIRED IN PRODUCTION, 32+ characters each — `openssl rand -hex 32`.
# AUTH_COOKIE_SECRET signs the login cookie; APP_AUTH_SECRET derives the keys
# for the PIN hash, device/connector token hashes and OAuth client ids. A
# production build refuses without them (scripts/security-preflight.mjs);
# development falls back to the PIN with a warning. Audit 2026-10, SEC-001/002.
AUTH_COOKIE_SECRET=""
APP_AUTH_SECRET=""
# NEXTAUTH_SECRET: legacy only — part of the pre-2026-10 fallback chain that
# old device tokens were hashed under; leave as-is if set, do not add.
# APP_PIN_RESET="1"  # recovery after rotating APP_AUTH_SECRET: re-seeds the
#                    # stored PIN from APP_PIN on the next matching login, then unset.
# Wrong-PIN lock across all clients (lib/auth.ts). Defaults 50 / 60 minutes;
# tripping it sends a systemAlerts notification.
# AUTH_GLOBAL_MAX_FAILURES="50"
# AUTH_GLOBAL_WINDOW_MINUTES="60"

# ── Cron protection (Vercel crons send Authorization: Bearer <this>) ─
CRON_SECRET=""

# ── Apple Health Shortcut (POST /api/health/daily; SHORTCUT_SETUP.md) ─
# The iPhone Shortcut sends Authorization: Bearer <this>. Unset = every push
# is refused. 16+ characters; generate with `openssl rand -hex 32`.
HEALTH_INGEST_TOKEN=""

# ── Finance module ───────────────────────────────────────────────────
# Master key encrypting Gmail OAuth tokens in the finance_vault table:
FINANCE_VAULT_MASTER_KEY=""
# Google OAuth app for read-only Gmail statement/receipt scanning:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Strava integration ───────────────────────────────────────────────
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Demo mode (demo/doctor-spanish branch; safe to omit) ─────────────
# DEMO_MODE=""
# NEXT_PUBLIC_DEMO_MODE=""
# NEXT_PUBLIC_DEMO_LANGUAGE=""
# DEMO_OPENAI_MODEL=""
# DEMO_AI_SPEND_LIMIT_USD=""
# DEMO_AI_MAX_COMPLETION_TOKENS=""

# Crossway ESV API — Spirit section Bible text, cross-references,
# footnotes, search, and audio. Free key: api.esv.org (non-commercial).
ESV_API_KEY=

# Web push (VAPID) — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# RENPHO Health scale cloud (unofficial API — see docs/renpho-gap-report.md).
# The pull stays OFF unless RENPHO_SYNC_ENABLED=1. Do not switch it on with
# your own app login: every API login signs the phone app out. Use a separate
# service account and name your own user id as the target.
RENPHO_EMAIL=""
RENPHO_PASSWORD=""
RENPHO_TARGET_USER_ID=""
RENPHO_SYNC_ENABLED=""
